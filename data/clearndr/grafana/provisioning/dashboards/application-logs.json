{
  "id": null,
  "uid": "application-logs",
  "title": "Application Logs",
  "tags": ["logs", "clearndr", "operations"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "opensearch-applogs"
        },
        "query": "{\"find\": \"terms\", \"field\": \"tag.keyword\"}",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "label": "Service"
      },
      {
        "name": "logfile",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "opensearch-applogs"
        },
        "query": "{\"find\": \"terms\", \"field\": \"log.file.name.keyword\"}",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "label": "Log File"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Log Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Error Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service AND (Body.value.keyword:*ERROR* OR Body.value.keyword:*FATAL*)",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Warning Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service AND (Body.value.keyword:*WARN* OR Body.value.keyword:*WARNING*)",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "tag.keyword",
              "settings": { "size": "10", "order": "desc", "orderBy": "_count" }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "lineWidth": 0,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 5,
      "title": "Log Files Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "3",
              "field": "log.file.name.keyword",
              "settings": { "size": "10", "order": "desc", "orderBy": "_count" }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "lineWidth": 0,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 6,
      "title": "Service Distribution",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "2",
              "field": "tag.keyword",
              "settings": { "size": "10", "order": "desc", "orderBy": "_count" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "title": "Logs by Service",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "2",
              "field": "tag.keyword",
              "settings": { "size": "10", "order": "desc", "orderBy": "_count" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7
      }
    },
    {
      "id": 8,
      "title": "Recent Logs",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 20 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-applogs"
      },
      "targets": [
        {
          "query": "tag.keyword:$service",
          "metrics": [{ "type": "logs", "id": "1" }],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false
}
