    {
      "id": 13,
      "title": "Source GeoIP Map",
      "type": "geomap",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-eve"
      },
      "targets": [
        {
          "query": "_exists_:geoip.location AND event_type.keyword:$event_type",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "geohash_grid",
              "id": "2",
              "field": "geoip.location",
              "settings": { "precision": "3" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 30,
          "lon": 0,
          "zoom": 2
        },
        "basemap": {
          "type": "default"
        },
        "layers": [
          {
            "type": "heatmap",
            "config": {
              "weight": { "field": "Count", "fixed": 1, "min": 0, "max": 1 },
              "radius": { "fixed": 20, "min": 1, "max": 50 },
              "blur": { "fixed": 15, "min": 1, "max": 50 },
              "opacity": 0.6
            }
          }
        ]
      }
    },
