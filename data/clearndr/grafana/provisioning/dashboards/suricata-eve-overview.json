            {
              "type": "terms",
              "id": "3",
              "field": "alert.severity",
              "settings": { "size": "5", "order": "asc", "orderBy": "_term" }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
