    {
      "id": 16,
      "title": "Traffic Volume Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-eve"
      },
      "targets": [
        {
          "query": "event_type.keyword:flow",
          "metrics": [
            { "type": "sum", "id": "1", "field": "flow.bytes_toserver", "settings": {} },
            { "type": "sum", "id": "2", "field": "flow.bytes_toclient", "settings": {} }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "3",
              "field": "@timestamp",
              "settings": { "interval": "auto" }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Sum flow.bytes_toserver" },
            "properties": [
              { "id": "displayName", "value": "Bytes to Server" },
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sum flow.bytes_toclient" },
            "properties": [
              { "id": "displayName", "value": "Bytes to Client" },
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] }
      }
    }
