server {
    listen 8080;
    server_name _;

    # Health check endpoint
    location / {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Scirius MCP Proxy - Injects Authorization header
    location /scirius-mcp {
        # For GET requests (SSE), return a minimal SSE stream
        # Scirius doesn't send server-initiated notifications anyway
        if ($request_method = GET) {
            add_header Content-Type text/event-stream;
            add_header Cache-Control no-cache;
            add_header Connection keep-alive;
            add_header X-Accel-Buffering no;
            return 200 "";
        }

        # For POST requests, forward to Scirius with Authorization
        rewrite ^/scirius-mcp(.*)$ /mcp$1 break;

        proxy_pass http://scirius:8000;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Token __SCIRIUS_TOKEN__";
        proxy_set_header Accept "application/json";

        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
