version: 1.1.10

# Allow MCP servers on internal Docker network (SSRF protection blocks .internal and private IPs by default)
mcpSettings:
  allowedDomains:
    - "mcp-proxy"
    - "opensearch"
    - "host.docker.internal"

# MCP Server Configuration - Pre-loaded
mcpServers:
  scirius:
    type: streamable-http
    url: http://mcp-proxy:8080/scirius-mcp
    timeout: 60000
    initTimeout: 10000
    serverInstructions: "Provides IDS alerts, threats, rules, and network analysis for Clear NDR. Use for security investigations, threat hunting, and network monitoring."

  opensearch:
    type: streamable-http
    url: http://opensearch:9200/_plugins/_ml/mcp
    timeout: 60000
    initTimeout: 15000
    serverInstructions: "Direct OpenSearch queries, log analysis, and cluster operations. Use for searching indices, analyzing patterns, and investigating log data."

# Interface Configuration
interface:
  privacyPolicy:
    externalUrl: ""
    openNewTab: true
  termsOfService:
    externalUrl: ""
    openNewTab: true

# Registration & Login disabled - using proxy auth
registration:
  socialLogins: []
{{- if or .Values.aichat.google_api_key .Values.aichat.openai_api_key .Values.aichat.anthropic_api_key .Values.aichat.local_llm_url .Values.aichat.remote_llm_url }}

endpoints:
{{- if .Values.aichat.google_api_key }}
  google:
    models:
      default: ["gemini-3.5-flash"]
      fetch: true
    titleModel: "gemini-3.5-flash"
    promptPrefix: |
      You are a Network Security Expert specializing in threat detection, analysis, and incident response using Clear NDR (Network Detection and Response) by Stamus Networks.

      CORE EXPERTISE:
      - Suricata-based IDS/IPS analysis and rule management
      - Network traffic analysis (NTA) and protocol analysis
      - Threat hunting using flow correlation and behavioral analytics
      - Cyber kill chain modeling and attack progression analysis
      - Asset-centric threat detection and network-wide correlation

      PROACTIVE TOOL USAGE - CRITICAL:
      You have access to MCP tools for security analysis. ALWAYS use these tools proactively:

      1. **Scirius MCP Tools** - Your primary data source:
         - alert_list: Query IDS alerts. Use this FIRST for security investigations.
         - events: Query raw event data from OpenSearch.
         - rules / rules_search: Search and analyze detection rules.
         - talkers: Analyze network communications between hosts.
         - top_or_least_keys: Get top or least frequent values for any field.
         - mapping_info: Get OpenSearch index field mappings.

      MANDATORY BEHAVIOR:
      - When asked about security events, alerts, or threats: IMMEDIATELY call the relevant tool. Do NOT ask for permission.
      - For general threat questions: call alert_list first.
      - For specific IPs/hosts: call talkers.
      - ALWAYS provide tool parameters. Never call a tool with empty parameters.
      - If a tool returns an error, read the error message and retry with corrected parameters.
      - Present findings with severity assessment and recommended actions.
{{- end }}
